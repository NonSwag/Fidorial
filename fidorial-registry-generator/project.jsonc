// Generates the registry sources and datasets of fidorial-api and fidorial-server from Mojang's data generator
// and PrismarineJS minecraft-data. Each of them configures it in "extensions": { "registry-generator": ... }.
// From the root: `jpm run generate-registries`. Here: `jpm start -- ../fidorial-api` (or any module directory).
// A project of its own, like fidorial-build-tools: its dependencies must not move the server's.
{
  "$schema": "https://github.com/java-package-manager/jpm/releases/latest/download/project.schema.json",
  "name": "fidorial-registry-generator",
  "group": "fr.fidorial",
  "version": "0.1.0",
  "java": "25",
  "layout": "maven",
  "main": "fr.fidorial.registrygen.Main",
  "runtime": {
    "net.kyori:adventure-api": "5.2.0",
    "com.google.code.gson:gson": "2.15.0",
    "com.palantir.javapoet:javapoet": "0.18.0"
  }
}

{
  "$schema": "https://github.com/java-package-manager/jpm/releases/latest/download/project.schema.json",
  "name": "fidorial-auth",
  "visibility": "internal",
  "runtime": {
    "com.google.code.gson:gson": "2.15.0",
    "org.slf4j:slf4j-api": "2.0.20",
    "org.jspecify:jspecify": "1.0.1"
  },
  "javacArgs": ["--add-reads", "fr.fidorial.auth=ALL-UNNAMED"]
}

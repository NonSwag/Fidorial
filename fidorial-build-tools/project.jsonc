// Code-quality tooling that ran inside the Gradle build:
//   jpm run lint              ErrorProne + NullAway
//   jpm run format [--check]  the Spotless formatting steps
//   jpm run spotbugs          SpotBugs over fidorial-server
// Run them here or from the root. This project has no sources; it gives the scripts in ../scripts their
// classpath. It is a project of its own, with its own project.lock, not a workspace module: jpm resolves one
// version of each package per workspace, and the tools' dependencies must not move the server's.
{
  "$schema": "https://github.com/java-package-manager/jpm/releases/latest/download/project.schema.json",
  "name": "fidorial-build-tools",
  "version": "0.1.0",
  "java": "25",
  "runtime": {
    "com.google.errorprone:error_prone_core": "2.52.0",
    "com.uber.nullaway:nullaway": "0.14.3",
    "com.diffplug.spotless:spotless-lib": "4.11.0",
    "com.diffplug.spotless:spotless-lib-extra": "4.11.0",
    "com.github.javaparser:javaparser-core": "3.28.2",
    "com.google.googlejavaformat:google-java-format": "1.37.0",
    "com.github.spotbugs:spotbugs": "4.10.5",
    "com.google.code.gson:gson": "2.15.0"
  },
  "scripts": {
    "lint": "../scripts/Lint.java",
    "format": "../scripts/Format.java",
    "spotbugs": "../scripts/SpotBugs.java"
  }
}

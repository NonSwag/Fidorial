{
  "$schema": "https://github.com/java-package-manager/jpm/releases/latest/download/project.schema.json",
  "name": "fidorial-api",
  "description": "Plugin API for the Fidorial Minecraft server",
  "license": "MIT",
  "url": "https://repo.euphyllia.moe",
  "layout": "maven",
  "visibility": "public",
  "runtime": {
    "net.kyori:adventure-api": "5.2.0",
    "net.kyori:adventure-key": "5.2.0",
    "net.kyori:adventure-nbt": "5.2.0",
    "net.kyori:adventure-text-serializer-gson": "5.2.0",
    "net.kyori:adventure-text-minimessage": "5.2.0",
    "net.kyori:adventure-text-logger-slf4j": "5.2.0",
    "net.kyori:adventure-text-serializer-ansi": "5.2.0",
    "net.kyori:adventure-text-serializer-plain": "5.2.0",
    "com.mojang:brigadier": "1.3.11",
    "com.google.code.gson:gson": "2.15.0",
    "com.google.guava:guava": "33.7.2-jre",
    "org.jspecify:jspecify": "1.0.1",
    "org.slf4j:slf4j-api": "2.0.20",
    "it.unimi.dsi:fastutil": "8.5.19",
    "org.spongepowered:configurate-yaml": "4.3.0-GeyserMC"
  },
  "dev": {
    "org.jetbrains:annotations": "26.1.0",
    "workspace:fidorial-annotation-processor": "*"
  },
  "javacArgs": ["--add-reads", "fr.fidorial=ALL-UNNAMED"],
  "extensions": {
    // `jpm run generate-registries` (from the root), see fidorial-registry-generator
    "registry-generator": {
      // "--server" additionally dumps the vanilla tag files the dataset is built from.
      "dataGeneratorArguments": ["--reports", "--server"],
      "registriesDatasetDirectory": "src/main/resources/fidorial-data",
      // FrozenRegistries is generated once, in fidorial-server, where the runtime reads it.
      "frozenRegistries": []
    }
  }
}
